# Copy this file to .env (gitignored) and fill in the values.
# Names only here. Never commit real values and never paste them into a chat.

# --- LLM providers (pipeline and backend only; the frontend never sees these) ---
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Web search for management bios ---
TAVILY_API_KEY=

# --- Model names come from env only, never from code (see CLAUDE.md section 6) ---
LLM_CHEAP_MODEL=
LLM_STRONG_MODEL=
LLM_FALLBACK_MODEL=

# --- Backend ---
ADMIN_TOKEN=
# Comma-separated list of allowed CORS origins: the Vercel domain plus localhost
ALLOWED_ORIGINS=
# Max fresh (uncached) LLM research runs per day; cached results are unlimited
DAILY_FRESH_RESEARCH_CAP=

# --- Optional: limits and storage (sensible defaults exist) ---
# Per-IP request limits: each endpoint's own default, and one ceiling across all routes
RATE_LIMIT_DEFAULT=
RATE_LIMIT_GLOBAL=
# Where the SQLite cache lives (default backend/.cache/finn.sqlite)
CACHE_PATH=
